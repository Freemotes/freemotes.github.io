<!DOCTYPE html>
<html>
<head>
{% set defaultOG = "https://freemotes.art/images/KirbyWave-112.png" %}
{% set ogImage = image or defaultOG %}


  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta content="Free emotes for everyone" property="og:title">
  <meta content="Freemotes.art is a collection of emotes for anyone to use. No AI. No strings attached. Free emotes for everyone!" property="og:description">
  <meta property="og:image" content="{{ ogImage }}">
  <title>
  {% if title %}
    {% if title.includes("Freemotes") %}
      {{ title }}
    {% else %}
      Freemotes - {{ title }}
    {% endif %}
  {% else %}
    Freemotes
  {% endif %}
</title>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/info/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/info/favicon-192.png">
<link rel="apple-touch-icon" href="/info/favicon-192.png">
  <link rel="stylesheet" href="/styles.css">
</head>
<script src="/scripts/search.js"></script>
<body>

<div class="wrapper">
  <header>
    <nav>
      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navMenu">
        ☰ Menu
      </button>

      <ul id="navMenu">
        <li><a href="/">Home</a></li>
        <li><a href="/emotes/">Emotes</a></li>
        <li><a href="/about">About Me</a></li>
        <li><a href="/support">Support Me</a></li>
        <li class="search">
          <div class="searchWrap">
            <input
              type="text"
              class="searchInput"
              placeholder="Search emotes..."
              autocomplete="off"
            />
            <button class="searchButton">Search</button>
            <ul class="suggestions"></ul>
          </div>
        </li>
      </ul>
    </nav>
  </header>


  <main class="page-body">
    <h1>{{ title }}</h1>

    {% if image %}
      <img src="{{ image }}" alt="{{ title }}" width="112" height="112">
    {% endif %}

      {% if image_56 %}
      <img src="{{ image_56 }}" alt="{{ title }}">
    {% endif %}

      {% if image_28 %}
      <img src="{{ image_28 }}" alt="{{ title }}">
    {% endif %}

    {% if description %}
      <p>{{ description }}</p>
    {% endif %}

    {{ content | safe }}

    {% if image_56 or image_28 %}
  <p>
    ⚠️ For the best quality, PLEASE(!) disable the "Auto-resize" slider, and instead upload the 3 images to their respective dimension slots. For most static emotes, I make little changes to the 28x28 files to restore details that get lost in the resizing process, such as eyes, teeth, and fingers. Thanks for understanding! ⚠️ 
  </p>

  <img src="/info/autoresize.gif">
  {% endif %}

  
<br />
<br />
{% if image %}
  <p>
    Don't forget to <a href="/attribute">attribute</a> the emotes when you upload them! It helps others find the original creator and supports the community. Thanks! 🙏 
  </p>
  <a href="/info/attribute1.png"><img src="/info/attribute1.png" width="122" height="134"></a>
  {% endif %}

    <h3>Search for an emote:</h3>

    <div class="searchWrap">
      <input
        type="text"
        class="searchInput"
        placeholder="Search emotes..."
        autocomplete="off"
      />
      <button class="searchButton">Search</button>
      <ul class="suggestions"></ul>
    </div>

  </main>

  <footer class="page-footer">
    <p>
      Emotes created by <a href="https://www.twitch.tv/gromfalloon" target="_blank" rel="noopener noreferrer">Gromfalloon</a> on Twitch, please <a href="/attribute">attribute</a> the emotes when you upload them. 
    </p>
  </footer>
  </div>

</body>
</html>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script>
async function downloadEmote() {
  // Build array safely (ignore empty strings)
  const images = [];

  if ("{{ image }}") images.push("{{ image }}");
  if ("{{ image_56 }}" && "{{ image_56 }}" !== "") images.push("{{ image_56 }}");
  if ("{{ image_28 }}" && "{{ image_28 }}" !== "") images.push("{{ image_28 }}");

  // ✅ Debug (optional, helps confirm)
  console.log("Images found:", images);

  if (images.length === 1) {
    const a = document.createElement("a");
    a.href = images[0];
    a.download = images[0].split("/").pop();
    a.click();
    return;
  }

  // Multiple images → ZIP
  const zip = new JSZip();

  for (const img of images) {
    const res = await fetch(img);
    const blob = await res.blob();
    const filename = img.split("/").pop();
    zip.file(filename, blob);
  }

  const zipBlob = await zip.generateAsync({ type: "blob" });

  const a = document.createElement("a");
  a.href = URL.createObjectURL(zipBlob);

  const safeName = "{{ title | safe }}".toLowerCase().replace(/[^a-z0-9]+/g, "-");
  a.download = safeName + ".zip";

  a.click();
}
</script>