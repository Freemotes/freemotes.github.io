---
layout: layout.njk
title: "Video file"
---
Hello! This page is for Grom's eyes only. What are you doing here? :) 
<br /> <br />

<label for="columnsInput">Emotes per row:</label>
<input id="columnsInput" type="number" min="1" max="60" value="3">

<label for="gapSlider">Gap between emotes:</label>
<input id="gapSlider" type="range" min="10" max="50" value="10">
<br /> <br /><br /> <br />
{% set sortedEmotes = collections.emotes | reverse %}

{# Find latest date (YYYY-MM-DD) #}
{% set latestDate = null %}

{% for emote in sortedEmotes %}
  {% if emote.inputPath != "./src/emotes/index.md" %}

    {% set emoteDate = emote.date.toISOString().slice(0,10) %}

    {% if not latestDate %}
      {% set latestDate = emoteDate %}
    {% endif %}

  {% endif %}
{% endfor %}

<div class="grid" id="emoteGrid">
  {% for emote in sortedEmotes %}
    {% if emote.inputPath != "./src/emotes/index.md" %}

      {% set emoteDate = emote.date.toISOString().slice(0,10) %}

      {% if emoteDate == latestDate %}
        <a class="card" href="{{ emote.url }}">
          <img loading="lazy" src="{{ emote.data.image }}" alt="{{ emote.data.title }}">
        </a>
      {% endif %}

    {% endif %}
  {% endfor %}
</div>



<style>
  #emoteGrid .card {
  width: 100%;
  height: 100%;
}

#emoteGrid .card img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* or contain if you prefer no cropping */
  display: block;
  border: 3px solid #f4ab00;
}

 #emoteGrid {
  display: grid;
  grid-template-columns: repeat(var(--columns, 3), 120px);
  grid-auto-rows: 120px;
  justify-content: start;
  gap: var(--gap, 10px);
}
</style>

<script>
  const grid = document.getElementById("emoteGrid");

  const columnsInput = document.getElementById("columnsInput");
  const gapSlider = document.getElementById("gapSlider");

  function updateColumns() {
    let cols = parseInt(columnsInput.value, 10);

    if (isNaN(cols) || cols < 1) cols = 1;
    if (cols > 60) cols = 60;

    grid.style.setProperty("--columns", cols);
  }

  function updateGap() {
    let gap = parseInt(gapSlider.value, 10);

    if (isNaN(gap) || gap < 0) gap = 0;
    if (gap > 50) gap = 50;

    grid.style.setProperty("--gap", gap + "px");
  }

  columnsInput.addEventListener("input", updateColumns);
  gapSlider.addEventListener("input", updateGap);

  // init
  updateColumns();
  updateGap();
</script>